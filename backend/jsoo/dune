; js_of_ocaml backend: the whole analyzer compiled to plain JavaScript.
;
; Build requires deps/mopsa-analyzer configured with --disable-c and its
; install tree exposed via OCAMLPATH (driven by `make jsoo-web`, see the
; root Makefile).

(executable
 (name mopsa_worker)
 (modes js)
 (modules mopsa_worker)
 (libraries
  mopsa.mopsa_analyzer
  js_of_ocaml
  zarith_stubs_js)
 (link_flags (:standard -linkall))
 (js_of_ocaml
  (flags --opt 3 --disable debugger --setenv TERM=xterm-256color)
  (javascript_files runtime_stubs.js))
 (preprocess
  (pps js_of_ocaml-ppx)))
