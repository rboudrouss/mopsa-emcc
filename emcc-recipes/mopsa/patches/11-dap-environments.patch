+  (** Depth of the statements of the current line: the depth of the first
+      statement that reached it, i.e. its statements as opposed to the
+      statements they are rewritten into. *)
+  let line_depth = ref 0
+
+  (** End of the last statement of the current line: the next statements of
+      the line end after it, the ones inside it are its parts *)
+  let line_end : pos option ref = ref None
+
+  (** Test if a statement contains statements of other lines (conditionals,
+      loops, function definitions): its post-state is not the state after
+      its line. *)
+  let has_other_lines stmt =
+    let line = get_range_line stmt.srange in
+    try
+      fold_stmt
+        (fun acc _ -> VisitParts acc)
+        (fun acc s ->
+           if acc then Keep true
+           else
+             let r = untag_range s.srange in
+             if is_orig_range r && get_range_line r <> line then Keep true
+             else VisitParts acc)
+        false stmt
+    with _ -> true
+
+  (** Test if [action] is a statement of the line started by [old.loc] *)
+  let is_line_stmt : type a. state -> a return_action -> bool = fun old action ->
+    match action with
+    | Eval _ -> false
+    | Exec({skind = S_block _},_) -> false
+    | Exec(stmt,_) ->
+      let range = untag_range stmt.srange in
+      is_orig_range range &&
+      state.depth = !line_depth &&
+      ( match !line_end with
+        | None -> false
+        | Some e -> compare_pos (get_range_end range) e > 0 ) &&
+      ( match old.loc with
+        | None -> false
+        | Some range' ->
+          let p = get_range_start range in
+          let p' = get_range_start range' in
+          p.pos_file = p'.pos_file && p.pos_line = p'.pos_line )
+
+  (** Test if a new line is reached by going back up in the same function,
+      i.e. by a loop going back to its head *)
+  let is_loop_back old range =
+    not (is_call old.callstack state.callstack) &&
+    match old.loc with
+    | None -> false
+    | Some range' ->
+      let p = get_range_start range in
+      let p' = get_range_start range' in
+      p.pos_file = p'.pos_file && p'.pos_line > p.pos_line
+
