   let name = "progress"
 
 
+  (** {2 Command-line options} *)
+  (** ************************ *)
+
+  (** Print the progress as JSON lines on stderr, for tools driving Mopsa *)
+  let opt_json = ref false
+  let () = register_builtin_option {
+      key = "-progress-json";
+      category = "Progress";
+      doc = " print the progress (hook progress) as JSON lines on stderr, at most every 100ms";
+      spec = Set opt_json;
+      default = "";
+    }
+
+
 
   (** {2 Entries of the progress table} *)
   (** ********************************* *)
@@ -80,6 +94,49 @@ struct
   let table : entry Stack.t = Stack.create ()
 
 
+  (** {2 JSON lines} *)
+  (** ************** *)
+
+  let last_json = ref neg_infinity
+
+  (** The last statement analyzed outside any function, e.g. the
+      initialization of the globals of the C library *)
+  let toplevel : range option ref = ref None
+
+  (** Print the table, outermost call first, as one JSON line:
+      [MOPSA_PROGRESS [{"function":"main","file":"a.c","line":14,"percent":42},...]].
+      Outside any function, one entry without a function nor a percentage:
+      [{"function":"","file":"stdio.c","line":869,"percent":-1}] *)
+  let print_json () =
+    (* Wall clock: Sys.time is constant in some runtimes (emscripten) *)
+    let now = Unix.gettimeofday () in
+    if now -. !last_json >= 0.1 then (
+      last_json := now;
+      let pp_json fmt (name, range, percent) =
+        fprintf fmt "{\"function\":%S,\"file\":%S,\"line\":%d,\"percent\":%d}"
+          name
+          (match range with Some r -> get_range_file r | None -> "")
+          (match range with Some r -> (get_range_start r).pos_line | None -> 0)
+          percent
+      in
+      let entries =
+        if Stack.is_empty table then
+          match !toplevel with
+          | Some r -> [("", Some r, -1)]
+          | None -> []
+        else
+          Stack.fold (fun acc e ->
+              (e.name, e.range,
+               if e.nb_all_stmt = 0 then 100 else 100*e.nb_analyzed_stmt/e.nb_all_stmt)
+              :: acc
+            ) [] table
+      in
+      eprintf "MOPSA_PROGRESS [%a]@."
+        (pp_print_list ~pp_sep:(fun fmt () -> pp_print_string fmt ",") pp_json)
+        entries
+    )
+
+
