diff --git a/utils/itvUtils/floats_round.c b/utils/itvUtils/floats_round.c
index 989abdce0..680cbcb62 100644
--- a/utils/itvUtils/floats_round.c
+++ b/utils/itvUtils/floats_round.c
@@ -64,7 +64,263 @@
 /* ********************************* */
 
 
-#if defined(__x86_64__) && defined(__GNUC__)
+/*
+  The rounding direction is set in hardware when possible.
+  It is emulated in software (SOFT_ROUNDING) when:
+  - the C library does not define FE_UPWARD, FE_DOWNWARD and FE_TOWARDZERO,
+    which C99 only defines for supported rounding directions;
+  - compiling to WebAssembly, which only supports rounding to nearest,
+    although Emscripten defines these macros;
+  - SOFT_ROUNDING is defined (-DSOFT_ROUNDING), e.g. on targets where
+    fesetround fails at run time.
+*/
+
+#if defined(__wasm__) || !defined(FE_UPWARD) || !defined(FE_DOWNWARD) || !defined(FE_TOWARDZERO)
+#ifndef SOFT_ROUNDING
+#define SOFT_ROUNDING
+#endif
+#endif
+
+
+#if defined(SOFT_ROUNDING)
+
+/*
+  Software path.
+
+  The rounding directions are emulated on top of rounding to nearest.
+  ROUND_* only records the direction in round_dir, and the R_* macros
+  below compute each operation with it.
+
+  Each operation computes r = RN(x) with the usual C operation, then the
+  sign of the rounding error x - r with an error-free transformation, and
+  moves r by one ulp when it was rounded in the wrong direction.
+  The result is the exact directed rounding, the same as with a hardware
+  rounding mode.
+
+  This requires IEEE 754 single and double precision arithmetic rounded to
+  nearest (in hardware or in a soft-float library), correctly rounded sqrt
+  and fma, and subnormal numbers (no flush-to-zero).
+  It must not be compiled with -ffast-math, which breaks error-free
+  transformations.
+*/
+
+enum { RND_NEAR, RND_UP, RND_DOWN, RND_ZERO };
+
+static int round_dir = RND_NEAR;
+
+#define ROUND_NEAR  round_dir = RND_NEAR
+#define ROUND_ZERO  round_dir = RND_ZERO
+#define ROUND_UP    round_dir = RND_UP
+#define ROUND_DOWN  round_dir = RND_DOWN
+
+/* r = RN(x), err has the sign of x - r (0 if r = x) */
+static inline double dbl_fix(double r, double err, int d)
+{
+  switch (d) {
+  case RND_UP:   return err > 0 ? nextafter(r, INFINITY) : r;
+  case RND_DOWN: return err < 0 ? nextafter(r, -INFINITY) : r;
+  case RND_ZERO: return (r > 0 && err < 0) || (r < 0 && err > 0) ? nextafter(r, 0) : r;
+  default:       return r;
+  }
+}
+
+/* r = RN(x) is infinite but x is finite */
+static inline double dbl_overflow(double r, int d)
+{
+  if ((d == RND_UP && r < 0) || (d == RND_DOWN && r > 0) || d == RND_ZERO)
+    return copysign(DBL_MAX, r);
+  return r;
+}
+
+/* Below 2^-967, the error terms computed with fma may not be exact.
+   We then compute on the mantissas m of the arguments (frexp), with err
+   the error on m, and scale back by 2^e.
+   y = ldexp(m, e) is RN(x) or one of its neighbours, and t = m - y*2^-e is
+   either 0 or larger than err, so x - y has the sign of t, or of err. */
+#define TINY 0x1p-967
+
+static inline double dbl_fix_scaled(double m, double err, int e, int d)
+{
+  double y = ldexp(m, e), t = m - ldexp(y, -e);
+  return dbl_fix(y, t != 0 ? t : err, d);
+}
+
+static inline double dbl_add(double a, double b, int d)
+{
+  double s = a + b;
+  if (d == RND_NEAR) return s;
+  if (!isfinite(s)) return isfinite(a) && isfinite(b) ? dbl_overflow(s, d) : s;
+  /* x + (-x) is -0 when rounding downwards */
+  if (s == 0) return d == RND_DOWN ? -(-a - b) : s;
+  /* Fast2Sum: b - (s - a) is the exact error when |a| >= |b| */
+  if (fabs(a) < fabs(b)) { double t = a; a = b; b = t; }
+  return dbl_fix(s, b - (s - a), d);
+}
+
+static inline double dbl_sub(double a, double b, int d)
+{
+  return dbl_add(a, -b, d);
+}
+
+static inline double dbl_mul(double a, double b, int d)
+{
+  double p = a * b;
+  if (d == RND_NEAR) return p;
+  if (!isfinite(p)) return isfinite(a) && isfinite(b) ? dbl_overflow(p, d) : p;
+  if (a == 0 || b == 0) return p;
+  if (fabs(p) < TINY) {
+    int ea, eb;
+    double ma = frexp(a, &ea), mb = frexp(b, &eb), m = ma * mb;
+    return dbl_fix_scaled(m, fma(ma, mb, -m), ea + eb, d);
+  }
+  /* a * b - p is exact */
+  return dbl_fix(p, fma(a, b, -p), d);
+}
+
+static inline double dbl_div(double a, double b, int d)
+{
+  double q = a / b;
+  if (d == RND_NEAR) return q;
+  if (!isfinite(q)) return isfinite(a) && isfinite(b) && b != 0 ? dbl_overflow(q, d) : q;
+  if (a == 0 || isinf(b)) return q;
+  if (fabs(a) < TINY || fabs(q) < TINY) {
+    int ea, eb;
+    double ma = frexp(a, &ea), mb = frexp(b, &eb), m = ma / mb, rem = fma(-m, mb, ma);
+    return dbl_fix_scaled(m, mb > 0 ? rem : -rem, ea - eb, d);
+  }
+  /* the remainder a - q * b is exact */
+  double rem = fma(-q, b, a);
+  return dbl_fix(q, b > 0 ? rem : -rem, d);
+}
+
+static inline double dbl_sqrt(double a, int d)
+{
+  double s = sqrt(a);
+  if (d == RND_NEAR || !(a > 0) || isinf(a)) return s;
+  if (a < TINY) {
+    /* the result is not tiny, so scaling it back is exact */
+    int e;
+    double m = frexp(a, &e);
+    if (e & 1) { m *= 2; e--; }
+    double sm = sqrt(m);
+    return ldexp(dbl_fix(sm, fma(-sm, sm, m), d), e / 2);
+  }
+  /* a - s * s is exact */
+  return dbl_fix(s, fma(-s, s, a), d);
+}
+
+static inline double dbl_rint(double a, int d)
+{
+  switch (d) {
+  case RND_UP:   return ceil(a);
+  case RND_DOWN: return floor(a);
+  case RND_ZERO: return trunc(a);
+  default:       return rint(a);
+  }
+}
+
+static inline float sgl_rint(float a, int d)
+{
+  switch (d) {
+  case RND_UP:   return ceilf(a);
+  case RND_DOWN: return floorf(a);
+  case RND_ZERO: return truncf(a);
+  default:       return rintf(a);
+  }
+}
+
+static inline float sgl_of_dbl(double x, int d)
+{
+  float f = (float)x;
+  switch (d) {
+  case RND_UP:   return (double)f < x ? nextafterf(f, INFINITY) : f;
+  case RND_DOWN: return (double)f > x ? nextafterf(f, -INFINITY) : f;
+  case RND_ZERO: return (f > 0 && (double)f > x) || (f < 0 && (double)f < x) ? nextafterf(f, 0) : f;
+  default:       return f;
+  }
+}
+
+/* Single-precision operations are rounded in double precision, then in
+   single precision, in the same direction.  This is the same as rounding
+   once in single precision, as every float is a double. */
+static inline float sgl_add(float a, float b, int d)
+{
+  return d == RND_NEAR ? a + b : sgl_of_dbl(dbl_add(a, b, d), d);
+}
+
+static inline float sgl_sub(float a, float b, int d)
+{
+  return d == RND_NEAR ? a - b : sgl_of_dbl(dbl_sub(a, b, d), d);
+}
+
+static inline float sgl_mul(float a, float b, int d)
+{
+  return d == RND_NEAR ? a * b : sgl_of_dbl(dbl_mul(a, b, d), d);
+}
+
+static inline float sgl_div(float a, float b, int d)
+{
+  return d == RND_NEAR ? a / b : sgl_of_dbl(dbl_div(a, b, d), d);
+}
+
+static inline float sgl_sqrt(float a, int d)
+{
+  return d == RND_NEAR ? sqrtf(a) : sgl_of_dbl(dbl_sqrt(a, d), d);
+}
+
+static inline double dbl_of_int64(int64_t i, int d)
+{
+  double x = (double)i;
+  if (d == RND_NEAR) return x;
+  /* c is the sign of x - i ((int64_t)x is undefined for x = 2^63) */
+  int c = x >= 0x1p63 ? 1 : ((int64_t)x > i) - ((int64_t)x < i);
+  return dbl_fix(x, -c, d);
+}
+
+static inline float sgl_of_int64(int64_t i, int d)
+{
+  float x = (float)i;
+  if (d == RND_NEAR) return x;
+  int c = x >= 0x1p63f ? 1 : ((int64_t)x > i) - ((int64_t)x < i);
+  switch (d) {
+  case RND_UP:   return c < 0 ? nextafterf(x, INFINITY) : x;
+  case RND_DOWN: return c > 0 ? nextafterf(x, -INFINITY) : x;
+  default:       return (x > 0 && c > 0) || (x < 0 && c < 0) ? nextafterf(x, 0) : x;
+  }
+}
+
+/* m * 10^e for m >= 0, rounded upwards or downwards */
+static double dbl_scale10(double m, int e, int d)
+{
+  /* when dividing, 10^-e must be rounded in the opposite direction */
+  int dp = e >= 0 ? d : d == RND_UP ? RND_DOWN : RND_UP;
+  int n = e >= 0 ? e : -e;
+  double p = 1;
+  /* beyond 10^400, p is already DBL_MAX or infinity */
+  for (int i = 0; i < n && i < 400; i++) p = dbl_mul(p, 10, dp);
+  if (m == 0) return m;
+  return e >= 0 ? dbl_mul(m, p, d) : dbl_div(m, p, d);
+}
+
+#define R_OP2(OP,a,b) \
+  _Generic((a) + (b), float: sgl_##OP, default: dbl_##OP)((a), (b), round_dir)
+
+#define R_ADD(a,b)        R_OP2(add, a, b)
+#define R_SUB(a,b)        R_OP2(sub, a, b)
+#define R_MUL(a,b)        R_OP2(mul, a, b)
+#define R_DIV(a,b)        R_OP2(div, a, b)
+#define R_SQRT(a)         dbl_sqrt((a), round_dir)
+#define R_SQRTF(a)        sgl_sqrt((a), round_dir)
+#define R_RINT(a)         dbl_rint((a), round_dir)
+#define R_RINTF(a)        sgl_rint((a), round_dir)
+#define R_LRINT(a)        ((long)dbl_rint((a), round_dir))
+#define R_LLRINT(a)       ((long long)dbl_rint((a), round_dir))
+#define R_TO_SGL(a)       sgl_of_dbl((a), round_dir)
+#define R_INT64_TO_DBL(a) dbl_of_int64((a), round_dir)
+#define R_INT64_TO_SGL(a) sgl_of_int64((a), round_dir)
+#define R_SCALE10(m,e)    dbl_scale10((m), (e), round_dir)
+
+#elif defined(__x86_64__) && defined(__GNUC__)
 
 /*
   Specific path for x86-64 with GCC inline assembly.
@@ -104,7 +360,7 @@ static const unsigned mxcsr_zero = 0x7f80;
 */
 
