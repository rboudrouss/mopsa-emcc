+
+/*
+  Operations rounded in the direction set by the last ROUND_*.
+  With hardware rounding modes, these are the usual C operations.
+*/
+
+#define R_ADD(a,b)        ((a) + (b))
+#define R_SUB(a,b)        ((a) - (b))
