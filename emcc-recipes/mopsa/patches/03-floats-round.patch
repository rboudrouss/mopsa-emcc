--- a/utils/itvUtils/float.ml
+++ b/utils/itvUtils/float.ml
@@ -59,6 +59,31 @@ external set_round_zero: unit -> unit = "ml_round_zero" [@@noalloc]
  *)
 
 
+(**
+   Conversion from Z.t to float, adapted from Zarith's Z.to_float.
+   Instead of the global rounding mode, the rounding is done by [of_int64]
+   and [mul], which must round in the same direction and precision.
+   [max_exp] is the largest exponent of the precision.
+ *)
+let z_to_float (of_int64: int64 -> t) (mul: t -> t -> t) (max_exp: int) (x: Z.t) : t =
+  let n = Z.numbits x in
+  if n <= 63 then
+    of_int64 (Z.to_int64 x)
+  else begin
+      let n = n - 55 in
+      (* Extract top 55 bits of x *)
+      let top = Z.shift_right x n in
+      (* Check if the other bits are all zero *)
+      let exact = Z.equal x (Z.shift_left top n) in
+      (* Unless the fractional part is exactly 0, round to an odd integer *)
+      let m = Z.to_int64 top in
+      let m = if exact then m else Int64.logor m 1L in
+      (* Round to float, then apply the exponent.
+         Beyond 2^max_exp, the product overflows anyway. *)
+      mul (of_int64 m) (ldexp 1. (min n max_exp))
+    end
+
+
 
 (** {2 Operations without rounding} *)
 
