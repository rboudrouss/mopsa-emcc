+; floats_round.c requires FLT_EVAL_METHOD == 0. On i386, x87 evaluates
+; double expressions in extended precision (FLT_EVAL_METHOD == 2): use SSE2
+; arithmetic instead.
+(rule
+ (enabled_if (= %{architecture} i386))
+ (action (with-stdout-to fpmath_flags.sexp (echo "(-msse2 -mfpmath=sse)"))))
+
+(rule
+ (enabled_if (<> %{architecture} i386))
+ (action (with-stdout-to fpmath_flags.sexp (echo "()"))))
+
