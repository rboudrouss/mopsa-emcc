# 32-bit (i386) Debian, source of the Linux / CPython headers preloaded in the
# WASM build: `make extract-32-headers` copies them out of the image.
FROM --platform=linux/386 debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libc6-dev \
    linux-libc-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*
