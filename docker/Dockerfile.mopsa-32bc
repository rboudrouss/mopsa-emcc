# 32-bit OCaml environment for building mopsa.bc for wasm32 target.
# Source code is NOT baked in — it is mounted at /workspace at runtime.
# The opam switch and packages are cached in the mopsa-emcc-opam-32 Docker
# volume by build-mopsa-32bc.sh, so only the first run is slow.
FROM --platform=linux/386 debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    libgmp-dev \
    libmpfr-dev \
    pkg-config \
    m4 \
    unzip \
    bubblewrap \
    git \
    rsync \
    clang \
    libclang-dev \
    libclang-cpp-dev \
    llvm-dev \
    perl \
    && rm -rf /var/lib/apt/lists/*

# Build OCaml 5.4.1 from source with --host=i686-linux-gnu.
#
# Problem: Docker's 64-bit kernel reports x86_64 via uname -m even inside a
# linux/386 container.  OCaml's configure uses uname to detect the target and
# would wrongly select TARGET_amd64.  --host=i686-linux-gnu overrides the
# uname-based detection so configure targets i386 correctly.
#
# OCaml 5 note: the native-code backend for 32-bit x86 (i386) was removed in
# OCaml 5.0, so we build a BYTECODE-ONLY toolchain (--disable-native-compiler
# + `make world`).  That is all we need: mopsa-32.bc is bytecode, produced by
# ocamlc, and runs on the wasm32 bytecode interpreter.  Building bytecode with
# a 31-bit-int i386 ocamlc keeps integer/marshalling widths consistent with
# the wasm32 runtime.
RUN curl -fsSL \
        https://github.com/ocaml/ocaml/archive/refs/tags/5.4.1.tar.gz \
        | tar xz -C /tmp \
    && cd /tmp/ocaml-5.4.1 \
    && ./configure \
        --prefix=/opt/ocaml-32b \
        --host=i686-linux-gnu \
        --disable-native-compiler \
        --disable-ocamltest \
    && make -j"$(nproc)" world \
    && make install \
    && rm -rf /tmp/ocaml-5.4.1

ENV PATH="/opt/ocaml-32b/bin:${PATH}"

# Install opam i686 binary
RUN curl -fsSL \
    https://github.com/ocaml/opam/releases/download/2.1.6/opam-2.1.6-i686-linux \
    -o /usr/local/bin/opam \
    && chmod +x /usr/local/bin/opam

# CPython stub headers (Python.h, pyconfig.h, ...) for the cross C/Python
# analysis.  Installed in a dedicated layer at the end so it does not bust the
# cache of the expensive OCaml-from-source build above.  These 32-bit headers
# are extracted by `make extract-32-headers` and replace the host's headers,
# keeping SIZEOF_LONG/SIZEOF_VOID_P consistent with the 32-bit data model.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
